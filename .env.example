POSTGRES_DB=tender_search
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

APP_NAME=Tender Search Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
RANKING_MODE=ml_rerank
RANKING_PROVIDER=local_ml
SEARCH_RETRIEVAL_BACKEND=postgres
ML_ARTIFACTS_DIR=/app/ML/models/catboost_ranker_v1
ML_ITEM_EMBEDDINGS_PATH=/app/ML/data/orig/item_embeddings.float32.npy
BOOTSTRAP_DATASET=portal_csv
PORTAL_STE_CSV_PATH=/app/ML/data/orig/СТЕ_20260403/СТЕ_20260403.csv
PORTAL_CONTRACTS_CSV_PATH=/app/ML/data/orig/Контракты_20260403/Контракты_20260403.csv
PORTAL_IMPORT_TRUNCATE=false
PORTAL_IMPORT_STE_LIMIT=10000
PORTAL_IMPORT_CONTRACT_LIMIT=10000
PORTAL_IMPORT_PURCHASE_HISTORY_LIMIT=120
SEARCH_SEMANTIC_BACKEND=auto
SEARCH_SEMANTIC_MODEL_NAME=BAAI/bge-m3
SEARCH_SEMANTIC_USE_FAISS=true
SEARCH_SEMANTIC_SHORTLIST_SIZE=80
SEARCH_SEMANTIC_ALLOW_REMOTE_DOWNLOAD=false
BACKEND_INSTALL_SEMANTIC=false
HF_CACHE_HOST_PATH=/run/desktop/mnt/host/c/Users/your-user/.cache/huggingface
SEARCH_LEMMATIZER_CACHE_SIZE=50000
SEARCH_FALLBACK_VARIANT_CACHE_SIZE=50000
SEARCH_INDEX_CACHE_PATH=/app/.cache/search/hybrid_search_index.pkl
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800
DEMO_USER_ID=demo_customer_transport
DEMO_ORGANIZATION_ID=demo_org_transport

BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_HEALTHCHECK_START_PERIOD=1800s
